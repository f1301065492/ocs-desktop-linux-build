{
	"$schema": "https://json.schemastore.org/electron-builder.json",
	"appId": "ocs.enncy.cn",
	"extraMetadata": {
		"name": "OCS Desktop",
		"description": "OCS 浏览器自动化神器，一键浏览器多开，用户脚本环境一键配置。"
	},
	"productName": "OCS Desktop",
	"asar": false,
	"directories": {
		"output": "../../releases"
	},
	"compression": "maximum",
	"extraResources": [
		{
			"from": "../../tools/ocs-openclaw",
			"to": "tools/ocs-openclaw",
			"filter": ["**/*", "!test/**"]
		}
	],
	"copyright": "Copyright © 2021 ${author}",
	"files": [
		"out/**/*",
		"public/favicon.png",
		"public/favicon.icns",
		"public/favicon.ico",
		"public/icons/**/*",
		"package.json",
		"node_modules/**/*",
		"!**/*.map",
		"!node_modules/xlsx/dist/{shim.min,xlsx.core.min,xlsx.extendscript,xlsx.full.min,xlsx,xlsx.min,xlsx.mini.min}.js"
	],
	"nsis": {
		"oneClick": true
	},
	"electronLanguages": [
		"en-US",
		"en-GB",
		"zh-CN"
	],
	"publish": {
		"provider": "generic",
		"url": "https://github.com/f1301065492/ocs-desktop-linux-build/releases/latest/download/"
	},
	"win": {
		"icon": "public/favicon.png",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "nsis"
			}
		],
		"extraResources": [
			{
				"from": "../../bin/chrome/win-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	},
	"mac": {
		"icon": "public/favicon.icns",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "dmg"
			}
		],
		"extraResources": [
			{
				"from": "../../bin/chrome/mac-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	},
	"linux": {
		"icon": "build/icons",
		"artifactName": "ocs-${version}-setup-${os}-${arch}.${ext}",
		"target": [
			{
				"target": "AppImage"
			},
			{
				"target": "deb"
			}
		],
		"category": "Utility",
		"maintainer": "enncy <enncyemail@qq.com>",
		"executableArgs": ["--no-sandbox"],
		"extraResources": [
			{
				"from": "../../bin/chrome/linux-${arch}/",
				"to": "bin/chrome",
				"filter": ["**/*.zip"]
			}
		]
	},
	"deb": {
		"depends": [
			"libgtk-3-0",
			"libnotify4",
			"libnss3",
			"libxss1",
			"libxtst6",
			"xdg-utils",
			"libatspi2.0-0",
			"libsecret-1-0",
			"xvfb"
		]
	}
}

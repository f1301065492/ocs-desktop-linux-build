# 复制到机器 B 的 ~/.openclaw/.env（OpenClaw 会用 ${VAR} 做插值），别提交到任何仓库
# 机器 A（跑 OCS 的那台）的局域网地址 + 远程 API 端口，必须 https
OCS_BASE=https://192.168.1.30:15320
# 在 OCS「设置 → 远程 API」里生成，明文只显示一次
OCS_API_KEY=
# （强烈建议）证书指纹固定：取 curl -k https://<ip>:15320/api/v1/health 里的 certFingerprint
OCS_CERT_SHA256=
# 单请求超时（毫秒），默认 120000
# OCS_TIMEOUT_MS=120000
# 只在换成正经 CA 签发的证书时才需要设为 1
# OCS_TLS_STRICT=1
# 推送关键字（用 | 分隔的正则），不设则用内置的那几条
# OCS_WATCH_PATTERNS=登录成功|需要人工|密码错误|错误|超时
